rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The admin list lives in one place: the `emails` array of
    // config/admins, edited on the Admin → Admins page (and in the Firebase
    // console as a break-glass). The deploy-firestore-rules workflow seeds
    // it once (functions/scripts/seed-admins.js) before these rules go live.
    function adminListPath() {
      return /databases/$(database)/documents/config/admins;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(adminListPath())
        && request.auth.token.email in get(adminListPath()).data.emails;
    }

    // Exams: any logged-in employee can read; only the admin can write.
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Questions (including correctIndex) are admin-only. Employees get the
    // question text for their attempt from the startAttempt Cloud Function,
    // which never sends the correct answers.
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Results are written only by the submitAttempt Cloud Function (Admin
    // SDK, bypasses these rules), which grades the attempt server-side. The
    // document ID is "{examId}_{authUid}" (see resultDocId() in
    // src/lib/results.js), so there is at most one result per person and
    // exam; submitAttempt refuses to create a second one. An employee can
    // read their own results; admins read all and may update/delete (a
    // delete lets that person take the exam again).
    match /results/{resultId} {
      allow create: if false;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Attempts in progress, created by the startAttempt Cloud Function (ID
    // "{examId}_{authUid}"). The owner may only save their answers, and only
    // until the deadline plus 30 s grace (GRACE_MS in functions/attempts.js)
    // — answers saved in time count even if the final submit never arrives.
    // Admins can see who is mid-exam and delete a stuck attempt.
    match /attempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= resource.data.questions.size()
        && (resource.data.deadline == null
            || request.time < resource.data.deadline + duration.value(30, 's'));
      allow delete: if isAdmin();
      allow create: if false;
    }

    // Admin list. Only admins may read it — the app decides whether to show
    // the admin pages by whether this read succeeds. An admin can't remove
    // themselves, so the list can never end up empty from the app.
    match /config/admins {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt', 'updatedBy'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() > 0
        && request.resource.data.emails.size() <= 50
        && request.auth.token.email in request.resource.data.emails;
      allow create, delete: if false;
    }

    // Outgoing email queue for the "Trigger Email from Firestore" extension.
    // Only the emailResultOnCreate Cloud Function writes here (the Admin SDK
    // bypasses these rules), so no browser may read or queue mail.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
