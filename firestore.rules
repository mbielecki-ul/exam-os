rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The admin list lives in one place: the `emails` array of
    // config/admins, edited on the Admin → Admins page (and in the Firebase
    // console as a break-glass). The deploy-firestore-rules workflow seeds
    // it once (functions/scripts/seed-admins.js) before these rules go live.
    function adminListPath() {
      return /databases/$(database)/documents/config/admins;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(adminListPath())
        && request.auth.token.email in get(adminListPath()).data.emails;
    }

    // An exam with no allowedDomains (or an empty list) is open to anyone.
    // Otherwise the signer's email must end in one of the listed domains.
    // Note: this is a plain string comparison — the admin UI always lowercases
    // saved domains, but doesn't lowercase the signer's email domain here, so
    // a mixed-case email domain could slip past an intended restriction.
    function examAllowsEmail(examId, email) {
      let exam = get(/databases/$(database)/documents/exams/$(examId)).data;
      let domains = exam.allowedDomains;
      return domains == null || domains.size() == 0 || domains.hasAny([email.split('@')[1]]);
    }

    // Archived exams take no new results. Exams created before archiving
    // existed have no `archived` field, hence the default.
    function examNotArchived(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data.get('archived', false) != true;
    }

    // Exams: any logged-in employee can read; only the admin can write.
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Questions: any logged-in employee can read (needed to render a quiz —
    // note this means correctIndex is visible client-side; acceptable for an
    // internal, low-stakes knowledge check, not a proctored/high-stakes exam).
    // Only the admin can write.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Results: an employee can create their own result and read their own
    // history, but never read anyone else's or edit/delete results.
    // The admin can read everything.
    //
    // The document ID must be "{examId}_{authUid}" (see resultDocId() in
    // src/lib/results.js). That makes a second attempt at the same exam by
    // the same person land on the same document ID, which Firestore treats
    // as an update rather than a create — and only admins can update, so a
    // second attempt is rejected here, not just hidden in the UI.
    match /results/{resultId} {
      allow create: if isSignedIn()
        && request.resource.data.userEmail == request.auth.token.email
        && resultId == request.resource.data.examId + '_' + request.auth.uid
        && examAllowsEmail(request.resource.data.examId, request.auth.token.email)
        && examNotArchived(request.resource.data.examId);
      allow read: if isAdmin() || (isSignedIn() && resource.data.userEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Admin list. Only admins may read it — the app decides whether to show
    // the admin pages by whether this read succeeds. An admin can't remove
    // themselves, so the list can never end up empty from the app.
    match /config/admins {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt', 'updatedBy'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() > 0
        && request.resource.data.emails.size() <= 50
        && request.auth.token.email in request.resource.data.emails;
      allow create, delete: if false;
    }

    // Outgoing email queue for the "Trigger Email from Firestore" extension.
    // Only the emailResultOnCreate Cloud Function writes here (the Admin SDK
    // bypasses these rules), so no browser may read or queue mail.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
