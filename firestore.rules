rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Keep this list in sync with ADMIN_EMAILS in src/lib/firebase.js
      return isSignedIn() && request.auth.token.email in [
        'maximilian.bielecki@ul.com',
        'max@bielecki.at'
      ];
    }

    // Exams: any logged-in employee can read; only the admin can write.
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Questions: any logged-in employee can read (needed to render a quiz —
    // note this means correctIndex is visible client-side; acceptable for an
    // internal, low-stakes knowledge check, not a proctored/high-stakes exam).
    // Only the admin can write.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Results: an employee can create their own result and read their own
    // history, but never read anyone else's or edit/delete results.
    // The admin can read everything.
    //
    // The document ID must be "{examId}_{authUid}" (see resultDocId() in
    // src/lib/results.js). That makes a second attempt at the same exam by
    // the same person land on the same document ID, which Firestore treats
    // as an update rather than a create — and only admins can update, so a
    // second attempt is rejected here, not just hidden in the UI.
    match /results/{resultId} {
      allow create: if isSignedIn()
        && request.resource.data.userEmail == request.auth.token.email
        && resultId == request.resource.data.examId + '_' + request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }
  }
}
